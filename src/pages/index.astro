---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { availableTools } from '../data/tools';
import { profile, projects } from '../data/profile';

const liveCount = availableTools.length;
const featured = projects.find((p) => p.featured) ?? projects[0];

const sections = [
  { href: '/about', label: 'About', note: 'What I build, and what I build it with.' },
  { href: '/experience', label: 'Experience', note: 'Roles and work history.' },
  { href: '/projects', label: 'Projects', note: 'Everything I have shipped.' },
  { href: '/certifications', label: 'Certifications', note: 'Credentials, verifiable.' },
];
---

<BaseLayout
  title={`${profile.name} — Portfolio`}
  description={`Personal portfolio of ${profile.name}. ${liveCount} free, private, browser-based file tools — no uploads and no accounts.`}
>
  <div class="shell hero">
    <p class="badge fade">
      <span class="dot" aria-hidden="true"></span>
      {liveCount} free tools live
    </p>

    <h1 class="fade">Nikhil<span class="sur">Khilwani</span></h1>

    <div class="rule fade" aria-hidden="true"></div>

    <p class="lede fade">
      {profile.headline} Everything here runs <strong>entirely in your browser</strong> — no
      uploads, no accounts, nothing collected.
    </p>

    <div class="cta fade">
      <a class="btn btn--solid" href="/projects">
        See my work <Icon name="arrow" size={15} />
      </a>
      <a class="btn" href="/tools">Try the tools</a>
    </div>

    <ul class="links fade">
      <li>
        <a href={`mailto:${profile.email}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4.24-8 5-8-5V6l8 5 8-5Z"
            /></svg
          >
          Email
        </a>
      </li>
      <li>
        <a href="https://github.com/nikhilkhilwani" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M12 2A10 10 0 0 0 8.84 21.5c.5.08.66-.23.66-.5v-1.7c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.4 9.4 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.16.59.67.5A10 10 0 0 0 12 2Z"
            /></svg
          >
          GitHub
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/in/nikhilkhilwani" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM2.4 21h5.16V9.5H2.4V21Zm7.74-11.5H15v1.57h.07a3.5 3.5 0 0 1 3.16-1.74c3.38 0 4 2.22 4 5.11V21h-5.14v-5.7c0-1.36-.03-3.11-1.9-3.11-1.9 0-2.19 1.48-2.19 3v5.81h-4.86V9.5Z"
            /></svg
          >
          LinkedIn
        </a>
      </li>
    </ul>
  </div>

  <div class="shell home">
    {
      featured && (
        <section class="feat">
          <p class="eyebrow">Currently building</p>
          <h2 class="feat__name">{featured.name}</h2>
          <p class="feat__blurb">{featured.blurb}</p>
          <ul class="chips">
            {featured.stack.map((s) => <li class="chip">{s}</li>)}
          </ul>
          <a class="feat__go" href={featured.href ?? '/projects'}>
            Open the toolbox <Icon name="arrow" size={14} />
          </a>
        </section>
      )
    }

    <nav class="secs" aria-label="Sections">
      {
        sections.map((s) => (
          <a href={s.href}>
            <span class="secs__label">
              {s.label}
              <Icon name="arrow" size={14} />
            </span>
            <span class="secs__note">{s.note}</span>
          </a>
        ))
      }
    </nav>
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(40px, 8vw, 80px) clamp(32px, 6vw, 64px);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    align-self: flex-start;
    margin: 0;
    padding: 0.5em 1em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(110, 231, 215, 0.5); }
    70% { box-shadow: 0 0 0 11px rgba(110, 231, 215, 0); }
    100% { box-shadow: 0 0 0 0 rgba(110, 231, 215, 0); }
  }

  h1 {
    font-size: clamp(2.9rem, 10vw, 6.5rem);
    line-height: 0.98;
    margin: 0.45em 0 0;
  }
  .sur { display: block; color: var(--ink-dim); }

  .rule {
    width: 64px; height: 1px;
    background: var(--accent);
    opacity: 0.7;
    margin: clamp(24px, 4vw, 38px) 0;
  }

  .lede { font-size: clamp(1.02rem, 2.4vw, 1.3rem); max-width: 46ch; }
  .lede strong { color: var(--ink); font-weight: 400; }

  .cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.1rem;
    margin-top: clamp(26px, 4vw, 38px);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    margin: clamp(24px, 4vw, 38px) 0 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s, color 0.25s;
  }
  .links a:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .links svg { width: 15px; height: 15px; fill: currentColor; opacity: 0.8; }

  /* ---------- below the fold ---------- */
  .home {
    display: grid;
    gap: clamp(28px, 5vw, 48px);
    padding-bottom: clamp(20px, 4vw, 40px);
  }

  .feat {
    display: grid;
    gap: 0.85rem;
    border-top: 1px solid var(--line);
    padding-top: clamp(28px, 5vw, 44px);
  }
  .feat__name {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.4rem, 4vw, 1.9rem);
    letter-spacing: -0.015em;
    margin: 0;
  }
  .feat__blurb {
    margin: 0;
    color: var(--ink-dim);
    line-height: 1.75;
    max-width: 68ch;
  }
  .feat__go {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    justify-self: start;
    min-height: 44px;
    font-size: 0.9rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
  }
  .feat__go:hover { color: var(--accent); }

  .secs {
    display: grid;
    gap: 0.5rem;
    border-top: 1px solid var(--line);
    padding-top: clamp(24px, 4vw, 36px);
  }
  @media (min-width: 720px) {
    .secs { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
  }
  .secs a {
    display: grid;
    gap: 0.3rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .secs a:hover { border-color: var(--line-strong); }
  .secs__label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink);
    font-size: 0.95rem;
  }
  .secs a:hover .secs__label { color: var(--accent); }
  .secs__note { color: var(--ink-faint); font-size: 0.82rem; line-height: 1.5; }

  .fade {
    opacity: 0;
    transform: translateY(14px);
    animation: rise 0.9s cubic-bezier(0.22, 0.68, 0, 1) forwards;
  }
  .badge.fade { animation-delay: 0.05s; }
  h1.fade { animation-delay: 0.16s; }
  .rule.fade { animation-delay: 0.3s; }
  .lede.fade { animation-delay: 0.4s; }
  .cta.fade { animation-delay: 0.5s; }
  .links.fade { animation-delay: 0.6s; }
  @keyframes rise { to { opacity: 1; transform: none; } }

  @media (max-height: 520px) and (orientation: landscape) {
    h1 { font-size: clamp(2rem, 7vw, 3.4rem); }
    .rule { margin: 18px 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fade { animation: none; opacity: 1; transform: none; }
    .dot { animation: none; }
  }
</style>
