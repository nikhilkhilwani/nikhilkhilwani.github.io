---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Icon from '../../components/Icon.astro';

const CHECKS = [
  { key: 'aaNormal', label: 'AA · normal text', need: '4.5' },
  { key: 'aaaNormal', label: 'AAA · normal text', need: '7' },
  { key: 'aaLarge', label: 'AA · large text', need: '3' },
  { key: 'aaaLarge', label: 'AAA · large text', need: '4.5' },
  { key: 'uiComponent', label: 'UI components', need: '3' },
];
---

<ToolLayout slug="contrast-checker">
  <div class="ct">
    <section class="panel ct__inputs">
      <div class="field">
        <label for="ct-fg-text">Foreground</label>
        <div class="ct__row">
          <input id="ct-fg-text" type="text" value="#9aa3b2" spellcheck="false" autocomplete="off" />
          <input id="ct-fg" type="color" value="#9aa3b2" aria-label="Pick foreground color" />
        </div>
      </div>

      <button id="ct-swap" class="btn btn--sm ct__swap" type="button">
        <Icon name="shuffle" size={14} /> Swap
      </button>

      <div class="field">
        <label for="ct-bg-text">Background</label>
        <div class="ct__row">
          <input id="ct-bg-text" type="text" value="#0d1017" spellcheck="false" autocomplete="off" />
          <input id="ct-bg" type="color" value="#0d1017" aria-label="Pick background color" />
        </div>
      </div>
    </section>

    <section class="panel ct__score" aria-live="polite">
      <p class="eyebrow">Contrast ratio</p>
      <p id="ct-ratio" class="ct__ratio">4.52</p>
      <p id="ct-verdict" class="ct__verdict">Passes AA for normal text</p>

      <ul class="ct__checks">
        {
          CHECKS.map((c) => (
            <li data-check={c.key}>
              <span class="ct__mark" aria-hidden="true"><Icon name="check" size={13} /></span>
              <span class="ct__label">{c.label}</span>
              <span class="ct__need">{c.need}:1</span>
            </li>
          ))
        }
      </ul>

      <div class="ct__fix">
        <button id="ct-fix-aa" class="btn btn--sm" type="button">Fix to AA</button>
        <button id="ct-fix-aaa" class="btn btn--sm" type="button">Fix to AAA</button>
      </div>
      <p id="ct-fix-note" class="ct__note"></p>
    </section>

    <section id="ct-preview" class="ct__preview" aria-label="Live preview">
      <h2 class="ct__p-h">Large heading, 32px</h2>
      <p class="ct__p-b">
        Body copy at 16px — the size most of your interface actually uses. If this row is
        uncomfortable to read, the pair fails in practice regardless of the number above.
      </p>
      <p class="ct__p-s">Small print at 13px, the first thing to become unreadable.</p>
      <div class="ct__p-ui">
        <span class="ct__p-btn">Button</span>
        <span class="ct__p-border">Bordered box</span>
      </div>
    </section>

    <section class="ct__pair" aria-label="Current pair">
      <button class="copyrow" type="button" data-copy="" data-fmt="fg">
        <span class="copyrow__label">Foreground</span>
        <span class="copyrow__val" data-val="fg">—</span>
        <Icon name="copy" size={15} />
      </button>
      <button class="copyrow" type="button" data-copy="" data-fmt="bg">
        <span class="copyrow__label">Background</span>
        <span class="copyrow__val" data-val="bg">—</span>
        <Icon name="copy" size={15} />
      </button>
    </section>
  </div>
</ToolLayout>

<style>
  .ct { display: grid; gap: clamp(14px, 2vw, 20px); }
  @media (min-width: 860px) {
    .ct { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .ct__preview, .ct__pair { grid-column: 1 / -1; }
  }

  .ct__inputs { display: grid; gap: 0.9rem; align-content: start; }
  .ct__row { display: flex; gap: 0.5rem; }
  .ct__row input[type='text'] { font-family: var(--mono); min-width: 0; }
  .ct__swap { justify-self: start; }

  .ct__score { display: flex; flex-direction: column; gap: 0.35rem; }
  .ct__ratio {
    font-family: var(--serif);
    font-size: clamp(2.6rem, 9vw, 3.8rem);
    line-height: 1;
    margin: 0.1rem 0 0;
  }
  .ct__verdict { margin: 0 0 0.5rem; font-size: 0.88rem; color: var(--ink-dim); }

  .ct__checks { list-style: none; margin: 0.3rem 0 0; padding: 0; display: grid; gap: 0.3rem; }
  .ct__checks li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .ct__mark {
    width: 19px; height: 19px;
    flex: 0 0 auto;
    display: grid; place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: transparent;
  }
  .ct__checks li[data-pass] { color: var(--ink); }
  .ct__checks li[data-pass] .ct__mark {
    background: var(--good);
    border-color: var(--good);
    color: #05231a;
  }
  .ct__label { flex: 1 1 auto; }
  .ct__need { font-family: var(--mono); font-size: 0.76rem; opacity: 0.75; }

  .ct__fix { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.9rem; }
  .ct__note { margin: 0.5rem 0 0; min-height: 1.1em; font-size: 0.78rem; color: var(--warn); }

  .ct__preview {
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: clamp(20px, 3.5vw, 34px);
    background: #0d1017;
    color: #9aa3b2;
  }
  .ct__p-h { font-size: 32px; margin: 0 0 0.6rem; color: inherit; }
  .ct__p-b { font-size: 16px; line-height: 1.6; margin: 0 0 0.7rem; max-width: 60ch; }
  .ct__p-s { font-size: 13px; margin: 0 0 1.1rem; }
  .ct__p-ui { display: flex; gap: 0.7rem; flex-wrap: wrap; align-items: center; }
  .ct__p-btn {
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: currentColor;
  }
  .ct__p-btn { color: inherit; }
  .ct__p-border {
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
    border-radius: var(--r-sm);
    border: 1.5px solid currentColor;
  }

  .ct__pair { display: grid; gap: 0.5rem; }
  @media (min-width: 560px) {
    .ct__pair { grid-template-columns: 1fr 1fr; }
  }
  .ct__pair .copyrow { font: inherit; cursor: pointer; text-align: left; }
  .ct__pair .copyrow:hover { border-color: var(--accent); }
  .ct__pair .copyrow :global(svg) { color: var(--ink-faint); flex: 0 0 auto; }
</style>

<script>
  import { parseColor, rgbToHex, type RGB } from '../../lib/color/convert';
  import { evaluate, fixContrast, THRESHOLDS } from '../../lib/contrast/wcag';
  import { bindCopy, toast } from '../../lib/ui/clipboard';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const fgText = $<HTMLInputElement>('ct-fg-text');
  const bgText = $<HTMLInputElement>('ct-bg-text');
  const fgPick = $<HTMLInputElement>('ct-fg');
  const bgPick = $<HTMLInputElement>('ct-bg');
  const ratioEl = $<HTMLParagraphElement>('ct-ratio');
  const verdictEl = $<HTMLParagraphElement>('ct-verdict');
  const preview = $<HTMLElement>('ct-preview');
  const fixNote = $<HTMLParagraphElement>('ct-fix-note');

  let fg: RGB = { r: 154, g: 163, b: 178 };
  let bg: RGB = { r: 13, g: 16, b: 23 };

  function verdict(c: ReturnType<typeof evaluate>): string {
    if (c.aaaNormal) return 'Passes AAA — comfortable at any text size';
    if (c.aaNormal) return 'Passes AA for normal text, AAA for large only';
    if (c.aaLarge) return 'Large text only — fails AA below 24px';
    if (c.uiComponent) return 'Borders and icons only — not usable for text';
    return 'Fails every WCAG threshold';
  }

  function render(skip?: 'fg' | 'bg') {
    const fgHex = rgbToHex(fg);
    const bgHex = rgbToHex(bg);

    if (skip !== 'fg') fgText.value = fgHex;
    if (skip !== 'bg') bgText.value = bgHex;
    fgPick.value = fgHex;
    bgPick.value = bgHex;

    const c = evaluate(fg, bg);
    ratioEl.textContent = `${c.ratio.toFixed(2)}`;
    verdictEl.textContent = verdict(c);

    for (const [key, pass] of Object.entries(c)) {
      if (key === 'ratio') continue;
      const li = document.querySelector<HTMLElement>(`[data-check="${key}"]`);
      if (li) li.toggleAttribute('data-pass', pass === true);
    }

    preview.style.background = bgHex;
    preview.style.color = fgHex;

    for (const [key, value] of [['fg', fgHex], ['bg', bgHex]] as const) {
      const cell = document.querySelector<HTMLElement>(`[data-val="${key}"]`);
      if (cell) cell.textContent = value;
      const row = document.querySelector<HTMLElement>(`[data-fmt="${key}"]`);
      if (row) row.dataset.copy = value;
    }

    const url = new URL(location.href);
    url.searchParams.set('fg', fgHex.slice(1));
    url.searchParams.set('bg', bgHex.slice(1));
    history.replaceState(null, '', url);
  }

  fgText.addEventListener('input', () => {
    const rgb = parseColor(fgText.value);
    if (rgb) { fg = rgb; render('fg'); }
  });
  bgText.addEventListener('input', () => {
    const rgb = parseColor(bgText.value);
    if (rgb) { bg = rgb; render('bg'); }
  });
  fgPick.addEventListener('input', () => {
    const rgb = parseColor(fgPick.value);
    if (rgb) { fg = rgb; render(); }
  });
  bgPick.addEventListener('input', () => {
    const rgb = parseColor(bgPick.value);
    if (rgb) { bg = rgb; render(); }
  });

  $<HTMLButtonElement>('ct-swap').addEventListener('click', () => {
    [fg, bg] = [bg, fg];
    fixNote.textContent = '';
    render();
  });

  function applyFix(target: number, name: string) {
    const fixed = fixContrast(fg, bg, target);
    if (!fixed) {
      fixNote.textContent = `Can't reach ${name} by changing the foreground alone — try a different background.`;
      return;
    }
    fg = fixed;
    fixNote.textContent = '';
    render();
    toast(`Foreground adjusted to ${rgbToHex(fixed)}`);
  }

  $<HTMLButtonElement>('ct-fix-aa').addEventListener('click', () => applyFix(THRESHOLDS.aaNormal, 'AA'));
  $<HTMLButtonElement>('ct-fix-aaa').addEventListener('click', () => applyFix(THRESHOLDS.aaaNormal, 'AAA'));

  bindCopy();

  const q = new URLSearchParams(location.search);
  fg = parseColor(`#${q.get('fg') ?? ''}`) ?? fg;
  bg = parseColor(`#${q.get('bg') ?? ''}`) ?? bg;
  render();
</script>
