---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Dropzone from '../../components/Dropzone.astro';
import Icon from '../../components/Icon.astro';
import { UNLOCK_CAVEATS } from '../../lib/pdf/unlock';
---

<ToolLayout slug="unlock-pdf">
  <div class="up">
    <Dropzone
      id="up-file"
      accept="application/pdf"
      icon="unlock"
      label="Choose a protected PDF, or drop one anywhere"
      hint="For a password you already know. Nothing is uploaded, and nothing here guesses or breaks a password."
    />

    <section class="panel" id="up-state" hidden>
      <p class="eyebrow" id="up-kind">—</p>
      <p class="up__lede" id="up-explain"></p>

      <div class="field" id="up-pass-field" hidden>
        <label for="up-pass">Password</label>
        <div class="up__row">
          <input id="up-pass" type="password" autocomplete="off" spellcheck="false" />
          <button id="up-reveal" class="btn btn--sm" type="button" aria-pressed="false">Show</button>
        </div>
        <p class="up__err" id="up-pass-err" role="status" aria-live="polite"></p>
      </div>

      <div class="up__actions" id="up-actions" hidden>
        <button id="up-run" class="btn btn--solid btn--sm" type="button">
          <Icon name="unlock" size={15} /> Remove and download
        </button>
        <button id="up-clear" class="btn btn--sm" type="button">
          <Icon name="trash" size={15} /> Clear
        </button>
      </div>

      <details class="up__caveats" id="up-caveats" hidden>
        <summary>What rebuilding the file cannot carry over</summary>
        <p>
          Removing encryption means rebuilding the document from its pages. Text,
          images, vectors, page size and annotations all come across. These do not:
        </p>
        <ul>
          {UNLOCK_CAVEATS.map((c) => <li>{c}</li>)}
        </ul>
        <p class="up__caveats-note">
          Document metadata such as the title is copied when the file still
          exposes it after decryption, which not all do.
        </p>
      </details>

      <p class="up__err" id="up-err" role="status" aria-live="polite"></p>
    </section>

    <ul class="up__result" id="up-result"></ul>
  </div>
</ToolLayout>

<style>
  .up { display: grid; gap: clamp(14px, 2vw, 20px); }

  .up__lede { color: var(--ink-dim); line-height: 1.65; margin: 0.6rem 0 0; max-width: 62ch; font-size: 0.93rem; }

  .up__row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .up__row input { flex: 1 1 12rem; min-width: 0; }
  .up__row .btn { flex: 0 0 auto; }

  #up-pass-field { margin-top: 1.2rem; }

  .up__err { margin: 0.5rem 0 0; font-size: 0.8rem; color: var(--bad); min-height: 1em; line-height: 1.5; }
  .up__actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.2rem; }

  .up__caveats {
    margin-top: 1.3rem;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
    font-size: 0.84rem;
    color: var(--ink-dim);
  }
  .up__caveats summary {
    cursor: pointer;
    color: var(--ink-dim);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    min-height: 32px;
    display: flex;
    align-items: center;
  }
  .up__caveats summary:hover { color: var(--ink); }
  .up__caveats p { margin: 0.7rem 0 0; line-height: 1.6; max-width: 62ch; }
  .up__caveats ul { margin: 0.5rem 0 0; padding-left: 1.2rem; line-height: 1.75; }
  .up__caveats-note { color: var(--ink-faint); font-size: 0.8rem; }

  .up__result { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
</style>

<!-- Runtime-created elements need global rules: Astro appends
     [data-astro-cid-…] to scoped selectors, and document.createElement() nodes
     never carry that attribute. Namespaced under this page's own list class. -->

<style is:global>
  .up__result .done {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    background: var(--surface);
    border: 1px solid color-mix(in srgb, var(--good) 35%, var(--line));
    border-radius: var(--r-sm);
    padding: 0.7rem 0.85rem;
  }
  .up__result .done__icon { color: var(--good); flex: 0 0 auto; display: grid; place-items: center; }
  .up__result .done__text { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; flex: 1 1 14rem; }
  .up__result .done__name { font-size: 0.9rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .up__result .done__meta { font-size: 0.76rem; color: var(--ink-faint); font-family: var(--mono); }
</style>

<script>
  import { initDropzone } from '../../lib/ui/dropzone';
  import { downloadBlob } from '../../lib/ui/download';
  import { toast } from '../../lib/ui/clipboard';
  import { formatBytes, stemOf } from '../../lib/ui/files';
  import { LIMITS } from '../../lib/ui/limits';
  import { unlockPdf, inspectEncryption, SourceEncrypted, type Encryption } from '../../lib/pdf/unlock';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const statePanel = $<HTMLElement>('up-state');
  const kindEl = $<HTMLParagraphElement>('up-kind');
  const explainEl = $<HTMLParagraphElement>('up-explain');
  const passField = $<HTMLElement>('up-pass-field');
  const pass = $<HTMLInputElement>('up-pass');
  const passErr = $<HTMLParagraphElement>('up-pass-err');
  const reveal = $<HTMLButtonElement>('up-reveal');
  const actions = $<HTMLElement>('up-actions');
  const caveats = $<HTMLElement>('up-caveats');
  const runBtn = $<HTMLButtonElement>('up-run');
  const clearBtn = $<HTMLButtonElement>('up-clear');
  const errEl = $<HTMLParagraphElement>('up-err');
  const result = $<HTMLUListElement>('up-result');

  let file: File | null = null;
  let bytes: Uint8Array | null = null;
  let kind: Encryption = 'none';
  let busy = false;

  const COPY: Record<Encryption, { label: string; explain: string }> = {
    none: {
      label: 'Nothing to remove',
      explain:
        'This PDF is not protected — it has no password and no permission restrictions. You can open, print and copy from it already.',
    },
    'owner-only': {
      label: 'Restricted, but not locked',
      explain:
        'This PDF opens without a password, but carries permission limits — typically on printing or copying. Those can be removed without a password.',
    },
    'user-password': {
      label: 'Password required',
      explain:
        'This PDF needs a password to open. Enter the one you already have and the protection will be removed from the copy you download.',
    },
  };

  async function inspect() {
    if (!file) return;
    errEl.textContent = '';
    passErr.textContent = '';
    result.replaceChildren();

    try {
      bytes = new Uint8Array(await file.arrayBuffer());
      kind = await inspectEncryption(bytes);
    } catch (err) {
      statePanel.hidden = true;
      errEl.textContent =
        err instanceof Error ? `Could not read that PDF: ${err.message}` : 'Could not read that PDF';
      return;
    }

    statePanel.hidden = false;
    kindEl.textContent = COPY[kind].label;
    explainEl.textContent = COPY[kind].explain;

    const needsPassword = kind === 'user-password';
    passField.hidden = !needsPassword;
    // Nothing to do for an unprotected file, so offer no action at all.
    actions.hidden = kind === 'none';
    caveats.hidden = kind === 'none';

    if (needsPassword) pass.focus();
  }

  async function run() {
    if (!bytes || !file || busy || kind === 'none') return;

    if (kind === 'user-password' && !pass.value) {
      passErr.textContent = 'Enter the password';
      pass.focus();
      return;
    }

    busy = true;
    runBtn.disabled = true;
    const label = runBtn.innerHTML;
    runBtn.textContent = 'Removing…';
    errEl.textContent = '';
    passErr.textContent = '';

    try {
      const out = await unlockPdf(bytes, kind === 'user-password' ? pass.value : undefined);

      const name = `${stemOf(file.name)}-unlocked.pdf`;
      // Copy into a plain ArrayBuffer so the Blob does not alias the library heap.
      const blob = new Blob([out.bytes.slice().buffer as ArrayBuffer], { type: 'application/pdf' });
      downloadBlob(blob, name);

      const li = document.createElement('li');
      li.className = 'done';
      const icon = document.createElement('span');
      icon.className = 'done__icon';
      icon.innerHTML =
        '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg>';
      const text = document.createElement('span');
      text.className = 'done__text';
      const nm = document.createElement('span');
      nm.className = 'done__name';
      nm.textContent = name;
      const meta = document.createElement('span');
      meta.className = 'done__meta';
      meta.textContent = [
        `${out.pages} page${out.pages === 1 ? '' : 's'}`,
        formatBytes(blob.size),
        out.keptMetadata.length ? `kept ${out.keptMetadata.join(', ')}` : 'no metadata survived',
      ].join(' · ');
      text.append(nm, meta);
      li.append(icon, text);
      result.replaceChildren(li);

      toast(kind === 'owner-only' ? 'Restrictions removed' : 'Password removed');
    } catch (err) {
      if (err instanceof SourceEncrypted) {
        passField.hidden = false;
        passErr.textContent = err.wrong ? 'That password did not open the file' : 'A password is needed';
        pass.focus();
      } else {
        errEl.textContent =
          err instanceof Error ? `Could not remove the protection: ${err.message}` : 'Could not remove the protection';
      }
    } finally {
      busy = false;
      runBtn.innerHTML = label;
      runBtn.disabled = false;
    }
  }

  initDropzone('up-file', {
    accept: ['application/pdf'],
    extensions: ['.pdf'],
    maxBytes: LIMITS.pdf,
    onTooLarge: (_r, message) => {
      errEl.textContent = message;
      statePanel.hidden = true;
    },
    onFiles: (files) => {
      file = files[0];
      pass.value = '';
      void inspect();
    },
    onReject: () => toast('That is not a PDF'),
  });

  reveal.addEventListener('click', () => {
    const shown = pass.type === 'text';
    pass.type = shown ? 'password' : 'text';
    reveal.setAttribute('aria-pressed', String(!shown));
    reveal.textContent = shown ? 'Show' : 'Hide';
  });

  pass.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') void run();
  });
  runBtn.addEventListener('click', () => void run());

  clearBtn.addEventListener('click', () => {
    file = null;
    bytes = null;
    kind = 'none';
    pass.value = '';
    statePanel.hidden = true;
    errEl.textContent = '';
    passErr.textContent = '';
    result.replaceChildren();
  });
</script>
