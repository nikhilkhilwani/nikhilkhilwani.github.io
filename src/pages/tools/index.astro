---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { TOOL_CATEGORIES, toolsByCategory, availableTools, tools } from '../../data/tools';

const liveCount = availableTools.length;
const plannedCount = tools.length - liveCount;
---

<BaseLayout
  title="Tools — Nikhil Khilwani"
  description={`${liveCount} free browser-based tools for color, images, and PDFs. Everything runs locally — no uploads, no accounts, no limits.`}
>
  <div class="shell">
    <header class="intro">
      <p class="eyebrow">Free tools</p>
      <h1>Small tools that<br />respect your files</h1>
      <p class="lede">
        Everything here runs entirely in your browser. Your files are never uploaded, there are no
        accounts, and there are no limits — because there's no server to bill for one.
      </p>
    </header>

    {
      TOOL_CATEGORIES.map((cat) => {
        const group = toolsByCategory(cat.id);
        if (group.length === 0) return null;
        return (
          <section class="group">
            <div class="group__head">
              <h2>{cat.label}</h2>
              <p>{cat.blurb}</p>
            </div>
            <div class="grid">
              {group.map((tool) => <ToolCard tool={tool} />)}
            </div>
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .intro {
    padding: clamp(36px, 7vw, 76px) 0 clamp(28px, 5vw, 52px);
    max-width: 52ch;
  }
  .intro h1 {
    font-size: clamp(2.1rem, 7vw, 3.6rem);
    margin: 0.5rem 0 0;
  }
  .intro .lede { margin-top: 1.1rem; font-size: clamp(0.97rem, 2.2vw, 1.08rem); }
  .count {
    margin: 1.3rem 0 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .group { padding-bottom: clamp(32px, 5vw, 56px); }
  .group__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.9rem;
    padding-bottom: 1rem;
    margin-bottom: 1.15rem;
    border-bottom: 1px solid var(--line);
  }
  .group__head h2 { font-size: clamp(1.2rem, 3vw, 1.5rem); }
  .group__head p { margin: 0; font-size: 0.84rem; color: var(--ink-faint); }

  .grid {
    display: grid;
    gap: clamp(12px, 1.8vw, 18px);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 258px), 1fr));
  }
</style>
