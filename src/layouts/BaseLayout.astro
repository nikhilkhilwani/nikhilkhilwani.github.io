---
import '../styles/global.css';
import Backdrop from '../components/Backdrop.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  /** Suppresses the site header on the landing page, which carries its own. */
  bare?: boolean;
}
const { title, description, bare = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Header links. `build.format: 'directory'` means every URL carries a trailing
// slash, so the path is normalised before comparing — otherwise nothing ever
// matches and no tab is ever marked current.
const NAV = [
  { href: '/about', label: 'About' },
  { href: '/experience', label: 'Experience' },
  { href: '/projects', label: 'Projects' },
  { href: '/certifications', label: 'Certifications' },
  { href: '/tools', label: 'Tools' },
];
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#eef1f4" />
    {/* Runs before first paint, and is:inline so Astro neither bundles nor
        defers it. Without this the light palette paints first and a stored dark
        choice applies a frame later, so every navigation flashes white. It
        resolves the system preference itself rather than leaning on the media
        query, which is what lets the CSS key the toggle icon off one attribute. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var mode =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        root.dataset.theme = mode;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', mode === 'dark' ? '#0e1319' : '#eef1f4');
      })();
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Backdrop />

    {
      bare ? (
        <div class="hdr-spacer"></div>
      ) : (
        <header class="hdr">
          <div class="shell hdr__in">
            <a class="hdr__brand" href="/">
              <span class="hdr__mark">NK</span>
              <span class="hdr__name">Nikhil Khilwani</span>
            </a>
            <div class="hdr__right">
              <nav class="hdr__nav" aria-label="Main">
                {
                  NAV.map((item) => (
                    <a
                      href={item.href}
                      aria-current={
                        path === item.href || path.startsWith(`${item.href}/`) ? 'page' : undefined
                      }
                    >
                      {item.label}
                    </a>
                  ))
                }
              </nav>
              {/* Both glyphs ship; CSS shows whichever matches the resolved
                  theme, so switching needs no DOM surgery. The label is set by
                  the script, because it has to name the ACTION rather than the
                  state to be any use to a screen reader. */}
              <button id="th-toggle" class="hdr__theme" type="button" aria-label="Switch theme">
                <Icon name="moon" size={15} class="th-moon" />
                <Icon name="sun" size={15} class="th-sun" />
              </button>
            </div>
          </div>
        </header>
      )
    }

    <main><slot /></main>

    <footer class="ftr">
      <div class="shell ftr__in">
        <span>&copy; {year} Nikhil Khilwani</span>
        <span class="ftr__note">
          <Icon name="lock" size={13} />
          Every tool runs in your browser — nothing is uploaded.
        </span>
      </div>
    </footer>

    <div id="toast" aria-live="polite" aria-atomic="true"><span></span></div>
  </body>
</html>

<style>
  main { position: relative; z-index: 1; }
  .hdr-spacer { display: none; }

  .hdr {
    position: relative;
    z-index: 2;
    border-bottom: 1px solid var(--line);
    /* The translucent background and the filter are BOTH load-bearing, and not
       for the blur — which is barely visible over a static gradient.
       Together they make this a non-opaque composited layer, and Chromium
       disables subpixel ("LCD") text inside one, giving grayscale
       antialiasing. That is the only lever available here: on Windows,
       -webkit-font-smoothing is ignored, so without this the body face picks
       up red and cyan fringing along every stem, which reads as a different
       typeface against a dark background.

       Measured: 0% fringed text pixels with these two lines, 96.6% without.
       Making the background opaque re-enables LCD text even if the layer is
       still promoted (translateZ(0) alone does NOT work), so the alpha has to
       stay. The 72% sits over the opaque .bg layer, so nothing outside the
       page can show through. Safe here because this header is not sticky, and
       the animated blurred backdrop that caused the real repaint bug is gone.

       The COLOUR must come from the theme, not a literal. It was hardcoded to
       the light ground, so dark mode got a pale grey bar across the top of a
       near-black page. --bg-rgb carries the triple precisely so the alpha above
       can survive while the hue follows the theme. */
    background: rgb(var(--bg-rgb) / 0.72);
    backdrop-filter: blur(10px);
  }
  .hdr__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 60px;
  }
  .hdr__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    min-height: 44px;
  }
  .hdr__mark {
    font-family: var(--serif);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--accent);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    width: 30px; height: 30px;
    display: grid; place-items: center;
    flex: 0 0 auto;
  }
  .hdr__name { font-size: 0.92rem; color: var(--ink); }
  @media (max-width: 420px) {
    .hdr__name { display: none; }
  }
  .hdr__nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.9rem;
  }
  .hdr__nav a {
    text-decoration: none;
    color: var(--ink-dim);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .hdr__nav a:hover { color: var(--accent); }
  .hdr__nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }

  /* Five links will not fit beside the brand on a phone — at 320px the row
     alone needs roughly 380px. Below 700px the header becomes two rows and the
     nav wraps, which keeps every 44px tap target and never pushes the document
     wider than the viewport. */
  .hdr__nav { flex-wrap: wrap; }
  @media (max-width: 700px) {
    .hdr__in {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding-block: 0.35rem;
    }
    .hdr__nav {
      gap: 0 1.1rem;
      font-size: 0.85rem;
      width: 100%;
    }
  }

  .ftr {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--line);
    margin-top: clamp(48px, 8vw, 96px);
  }
  .ftr__in {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    padding-block: var(--pad-y) calc(var(--pad-y) + env(safe-area-inset-bottom, 0px));
    color: var(--ink-faint);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .ftr__note { display: inline-flex; align-items: center; gap: 0.45rem; }
  @media (max-width: 640px) {
    .ftr__in { font-size: 0.72rem; }
  }
</style>

<script>
  /**
   * Theme toggle. The palette itself is entirely CSS — this only decides which
   * of the three states the document is in, and remembers it.
   */
  type Mode = 'light' | 'dark';

  const KEY = 'theme';
  const COLOR: Record<Mode, string> = { light: '#eef1f4', dark: '#0e1319' };

  const root = document.documentElement;
  const btn = document.getElementById('th-toggle');
  const meta = document.querySelector('meta[name="theme-color"]');
  const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');

  /** null when the visitor has never chosen, so the OS still leads. */
  function stored(): Mode | null {
    try {
      const v = localStorage.getItem(KEY);
      return v === 'light' || v === 'dark' ? v : null;
    } catch {
      // Private mode and blocked site data both throw on access.
      return null;
    }
  }

  function apply(mode: Mode) {
    root.dataset.theme = mode;
    meta?.setAttribute('content', COLOR[mode]);
    // The label names the ACTION, not the state — "dark theme" on a button
    // that switches to light tells a screen-reader user nothing.
    const label = mode === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
    btn?.setAttribute('aria-label', label);
    btn?.setAttribute('title', label);
  }

  // The inline head script already stamped the attribute; this only catches up
  // the label and title, which it deliberately left alone.
  apply(root.dataset.theme === 'dark' ? 'dark' : 'light');

  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem(KEY, next);
    } catch {
      // Not fatal — the choice just will not survive a reload.
    }
    apply(next);
  });

  // Keep following the OS for as long as the visitor has not overridden it.
  darkQuery.addEventListener('change', (e) => {
    if (!stored()) apply(e.matches ? 'dark' : 'light');
  });
</script>

<style>
  /* Nav and toggle travel together, so the toggle stays put when the nav wraps. */
  .hdr__right {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    min-width: 0;
  }

  .hdr__theme {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    /* 44px, like every other tap target on the site. */
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    color: var(--ink-dim);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .hdr__theme:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--lift-2);
  }

  /* Show the glyph for what the button DOES, not for the current theme: a moon
     while light, a sun while dark. Both ship in the markup so switching needs
     no DOM work.
     :global() is required — the <svg> is rendered by Icon.astro, so it never
     carries this component's data-astro-cid and a scoped rule would silently
     not apply. */
  .hdr__theme :global(.th-sun) { display: none; }

  /* The no-attribute case, for a visitor with JavaScript off. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .hdr__theme :global(.th-sun) { display: block; }
    :root:not([data-theme="light"]) .hdr__theme :global(.th-moon) { display: none; }
  }
  /* Last, so an explicit choice beats the OS in both directions. */
  :root[data-theme="dark"] .hdr__theme :global(.th-sun) { display: block; }
  :root[data-theme="dark"] .hdr__theme :global(.th-moon) { display: none; }

  @media (max-width: 700px) {
    .hdr__right {
      width: 100%;
      justify-content: space-between;
      gap: 0.75rem;
    }
  }
</style>
