---
import '../styles/global.css';
import Backdrop from '../components/Backdrop.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  /** Suppresses the site header on the landing page, which carries its own. */
  bare?: boolean;
}
const { title, description, bare = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Header links. `build.format: 'directory'` means every URL carries a trailing
// slash, so the path is normalised before comparing — otherwise nothing ever
// matches and no tab is ever marked current.
const NAV = [
  { href: '/about', label: 'About' },
  { href: '/experience', label: 'Experience' },
  { href: '/projects', label: 'Projects' },
  { href: '/certifications', label: 'Certifications' },
  { href: '/tools', label: 'Tools' },
];
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#07080c" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Newsreader:opsz,wght@6..72,300;6..72,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Backdrop />

    {
      bare ? (
        <div class="hdr-spacer"></div>
      ) : (
        <header class="hdr">
          <div class="shell hdr__in">
            <a class="hdr__brand" href="/">
              <span class="hdr__mark">NK</span>
              <span class="hdr__name">Nikhil Khilwani</span>
            </a>
            <nav class="hdr__nav" aria-label="Main">
              {
                NAV.map((item) => (
                  <a
                    href={item.href}
                    aria-current={
                      path === item.href || path.startsWith(`${item.href}/`) ? 'page' : undefined
                    }
                  >
                    {item.label}
                  </a>
                ))
              }
            </nav>
          </div>
        </header>
      )
    }

    <main><slot /></main>

    <footer class="ftr">
      <div class="shell ftr__in">
        <span>&copy; {year} Nikhil Khilwani</span>
        <span class="ftr__note">
          <Icon name="lock" size={13} />
          Every tool runs in your browser — nothing is uploaded.
        </span>
      </div>
    </footer>

    <div id="toast" aria-live="polite" aria-atomic="true"><span></span></div>
  </body>
</html>

<style>
  main { position: relative; z-index: 1; }
  .hdr-spacer { display: none; }

  .hdr {
    position: relative;
    z-index: 2;
    border-bottom: 1px solid var(--line);
    /* The translucent background and the filter are BOTH load-bearing, and not
       for the blur — which is barely visible over a static gradient.
       Together they make this a non-opaque composited layer, and Chromium
       disables subpixel ("LCD") text inside one, giving grayscale
       antialiasing. That is the only lever available here: on Windows,
       -webkit-font-smoothing is ignored, so without this Inter picks up red
       and cyan fringing along every stem that reads as a different typeface
       against a dark background.

       Measured: 0% fringed text pixels with these two lines, 96.6% without.
       Making the background opaque re-enables LCD text even if the layer is
       still promoted (translateZ(0) alone does NOT work), so the alpha has to
       stay. The 72% sits over the opaque .bg layer, so nothing outside the
       page can show through. Safe here because this header is not sticky, and
       the animated blurred backdrop that caused the real repaint bug is gone. */
    background: rgba(7, 8, 12, 0.72);
    backdrop-filter: blur(10px);
  }
  .hdr__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 60px;
  }
  .hdr__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    min-height: 44px;
  }
  .hdr__mark {
    font-family: var(--serif);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--accent);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    width: 30px; height: 30px;
    display: grid; place-items: center;
    flex: 0 0 auto;
  }
  .hdr__name { font-size: 0.92rem; color: var(--ink); }
  @media (max-width: 420px) {
    .hdr__name { display: none; }
  }
  .hdr__nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.9rem;
  }
  .hdr__nav a {
    text-decoration: none;
    color: var(--ink-dim);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .hdr__nav a:hover { color: var(--accent); }
  .hdr__nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }

  /* Five links will not fit beside the brand on a phone — at 320px the row
     alone needs roughly 380px. Below 700px the header becomes two rows and the
     nav wraps, which keeps every 44px tap target and never pushes the document
     wider than the viewport. */
  .hdr__nav { flex-wrap: wrap; }
  @media (max-width: 700px) {
    .hdr__in {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding-block: 0.35rem;
    }
    .hdr__nav {
      gap: 0 1.1rem;
      font-size: 0.85rem;
      width: 100%;
    }
  }

  .ftr {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--line);
    margin-top: clamp(48px, 8vw, 96px);
  }
  .ftr__in {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    padding-block: var(--pad-y) calc(var(--pad-y) + env(safe-area-inset-bottom, 0px));
    color: var(--ink-faint);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .ftr__note { display: inline-flex; align-items: center; gap: 0.45rem; }
  @media (max-width: 640px) {
    .ftr__in { font-size: 0.72rem; }
  }
</style>
