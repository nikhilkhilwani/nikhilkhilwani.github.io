---
import '../styles/global.css';
import Backdrop from '../components/Backdrop.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  /** Suppresses the site header on the landing page, which carries its own. */
  bare?: boolean;
}
const { title, description, bare = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#07080c" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Fraunces:opsz,wght@9..144,300;9..144,500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Backdrop />

    {
      bare ? (
        <div class="hdr-spacer"></div>
      ) : (
        <header class="hdr">
          <div class="shell hdr__in">
            <a class="hdr__brand" href="/">
              <span class="hdr__mark">NK</span>
              <span class="hdr__name">Nikhil Khilwani</span>
            </a>
            <nav class="hdr__nav" aria-label="Main">
              <a href="/tools" aria-current={Astro.url.pathname.startsWith('/tools') ? 'page' : undefined}>
                Tools
              </a>
            </nav>
          </div>
        </header>
      )
    }

    <main><slot /></main>

    <footer class="ftr">
      <div class="shell ftr__in">
        <span>&copy; {year} Nikhil Khilwani</span>
        <span class="ftr__note">
          <Icon name="lock" size={13} />
          Every tool runs in your browser — nothing is uploaded.
        </span>
      </div>
    </footer>

    <div id="toast" aria-live="polite" aria-atomic="true"><span></span></div>
  </body>
</html>

<style>
  main { position: relative; z-index: 1; }
  .hdr-spacer { display: none; }

  .hdr {
    position: relative;
    z-index: 2;
    border-bottom: 1px solid var(--line);
    /* Opaque, and no backdrop-filter. The header is not sticky, so the filter
       was blurring a static gradient — invisible, while costing a composited
       layer that re-samples its backdrop on every scroll frame. The old 72%
       alpha also let whatever was behind show through the header strip. */
    background: var(--bg);
  }
  .hdr__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 60px;
  }
  .hdr__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    min-height: 44px;
  }
  .hdr__mark {
    font-family: var(--serif);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--accent);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    width: 30px; height: 30px;
    display: grid; place-items: center;
    flex: 0 0 auto;
  }
  .hdr__name { font-size: 0.92rem; color: var(--ink); }
  @media (max-width: 420px) {
    .hdr__name { display: none; }
  }
  .hdr__nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.9rem;
  }
  .hdr__nav a {
    text-decoration: none;
    color: var(--ink-dim);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .hdr__nav a:hover { color: var(--accent); }
  .hdr__nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }

  .ftr {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--line);
    margin-top: clamp(48px, 8vw, 96px);
  }
  .ftr__in {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    padding-block: var(--pad-y) calc(var(--pad-y) + env(safe-area-inset-bottom, 0px));
    color: var(--ink-faint);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .ftr__note { display: inline-flex; align-items: center; gap: 0.45rem; }
  @media (max-width: 640px) {
    .ftr__in { font-size: 0.72rem; }
  }
</style>
