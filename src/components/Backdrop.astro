---
// The ambient wash + grid behind every page. Purely decorative, so it is
// aria-hidden and pointer-events:none.
//
// Deliberately ONE fixed layer with an opaque base, painted with soft radial
// gradients. The earlier version stacked three fixed boxes running
// `filter: blur(90px)` on a permanent 22s animation, plus a second masked
// fixed layer — five-plus continuously-invalidated composited layers. That
// combination produced stale-paint artifacts on real hardware: the page text
// composited over leftover pixels from a previously viewed page.
//
// Radial gradients are already soft, so the blur filter bought nothing that
// colour stops cannot, and dropping the animation removes the compositor's
// reason to re-rasterise a full-viewport blurred layer on every frame.
---

<div class="bg" aria-hidden="true"></div>

<style>
  .bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Opaque base. Belt-and-braces with body's background: if the compositor
       ever drops one paint, the other still covers the viewport. */
    background-color: var(--bg);
    /* rgba(…, 0) rather than `transparent`, which is rgba(0,0,0,0) and greys
       the midpoint of a gradient in most engines. */
    background-image:
      radial-gradient(52vmax 52vmax at 12% -6%, rgba(29, 78, 99, 0.42), rgba(29, 78, 99, 0) 68%),
      radial-gradient(44vmax 44vmax at 104% 16%, rgba(59, 44, 99, 0.4), rgba(59, 44, 99, 0) 66%),
      radial-gradient(40vmax 40vmax at 38% 108%, rgba(28, 83, 70, 0.38), rgba(28, 83, 70, 0) 66%);
  }

  /* The grid rides on the same layer as a pseudo-element rather than a second
     fixed box, so the mask cannot promote a whole extra layer of its own. */
  .bg::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 72px 72px;
    -webkit-mask-image: radial-gradient(ellipse 80% 65% at 50% 30%, #000 20%, transparent 78%);
    mask-image: radial-gradient(ellipse 80% 65% at 50% 30%, #000 20%, transparent 78%);
  }

  @media (max-width: 640px) {
    .bg::after { background-size: 48px 48px; }
  }
</style>
