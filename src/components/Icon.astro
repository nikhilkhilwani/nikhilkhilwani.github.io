---
// Hand-rolled 24x24 stroke icons. Inline SVG rather than an icon package:
// a handful of glyphs don't justify a dependency, and these ship as markup
// with no JS.
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls } = Astro.props;

const ICONS: Record<string, string> = {
  qr:
    '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14h1M14 20h3M20 18v3"/>',
  image: '<rect x="3" y="3" width="18" height="18" rx="2.5"/><circle cx="8.8" cy="9" r="1.6"/><path d="m3.5 17 4.7-4.3 4 3.4 3-2.4 5 4.3"/>',
  'file-out':
    '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5"/><path d="M9.5 14.5h5M12.5 12.5l2 2-2 2"/>',
  'file-image':
    '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5"/><circle cx="10" cy="13" r="1.2"/><path d="m7.5 18 2.8-2.6 2.4 2 1.8-1.4 2.5 2"/>',
  minimize: '<path d="M8 3v5H3M16 21v-5h5M21 8h-5V3M3 16h5v5"/>',
  lock: '<rect x="4.5" y="10.5" width="15" height="10.5" rx="2.2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/><circle cx="12" cy="15.6" r="1.3"/>',
  unlock: '<rect x="4.5" y="10.5" width="15" height="10.5" rx="2.2"/><path d="M8 10.5V7a4 4 0 0 1 7.5-2"/><circle cx="12" cy="15.6" r="1.3"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  copy: '<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M15 5.5A2.5 2.5 0 0 0 12.5 3H5.5A2.5 2.5 0 0 0 3 5.5v7A2.5 2.5 0 0 0 5.5 15"/>',
  download: '<path d="M12 3v12M7.5 10.5 12 15l4.5-4.5M4 20h16"/>',
  trash: '<path d="M4 7h16M9.5 7V4.8h5V7M6 7l1 13h10l1-13M10.5 11v5M13.5 11v5"/>',
  x: '<path d="M6 6l12 12M18 6 6 18"/>',
  up: '<path d="M12 19V5M6 11l6-6 6 6"/>',
  down: '<path d="M12 5v14M6 13l6 6 6-6"/>',
  sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4 17 7M7 17l-1.6 1.6"/>',
  moon: '<path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z"/>',
  // Two panels with a divider: the shape of a side-by-side comparison.
  compare:
    '<rect x="3" y="4" width="7.5" height="16" rx="1.5"/><rect x="13.5" y="4" width="7.5" height="16" rx="1.5"/><path d="M12 2.5v19"/>',
  'file-text':
    '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5"/><path d="M8.5 13h7M8.5 16.5h7M8.5 9.5h2"/>',
  // A document with its text flowing out to the right: the page stays, the
  // words come out of it.
  'file-word':
    '<path d="M13 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4"/><path d="M13 3v5h5V8Z"/><path d="M8.5 9.5h2M8.5 13h3"/><path d="M14 17h7"/><path d="m18.5 14 2.5 3-2.5 3"/>',
  // A picture frame with a luggage tag lifting away from it: the image stays,
  // the label attached to it does not.
  tag:
    '<path d="M3 5.5A2.5 2.5 0 0 1 5.5 3h7"/><path d="M3 5.5v13A2.5 2.5 0 0 0 5.5 21h9a2.5 2.5 0 0 0 2.5-2.5v-4"/><path d="M3.5 17l4.2-4.2a2 2 0 0 1 2.8 0L14 16.5"/><circle cx="8" cy="8.5" r="1.4"/><path d="M15.2 3.2h5.3a1 1 0 0 1 1 1v5.3a1 1 0 0 1-.3.7l-4.4 4.4a1 1 0 0 1-1.4 0l-5.3-5.3a1 1 0 0 1 0-1.4l4.4-4.4a1 1 0 0 1 .7-.3Z"/><circle cx="18.6" cy="6.6" r=".9"/>',
};

const path = ICONS[name] ?? ICONS['file-text'];
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={path}
/>
